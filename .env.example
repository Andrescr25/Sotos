# Copiar a ".env.local" (está en .gitignore) y completar. Sin EXPO_PUBLIC_API_URL
# la app usa datos en memoria (un solo dispositivo, sin servidor).
#
# OJO: estas variables se incrustan dentro de la app. Cualquiera con la app
# puede extraerlas; no son secretos fuertes.

# URL del servicio en Render, o la IP de tu computadora en desarrollo local:
#   https://sotos-server.onrender.com
#   http://192.168.1.50:10000
EXPO_PUBLIC_API_URL=

# Debe ser igual a la variable API_KEY del servidor.
EXPO_PUBLIC_API_KEY=
