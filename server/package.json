{
  "name": "sotos-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de pedidos (HTTP + WebSocket) para Render",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --alias:@=../src --external:pg-native --external:bufferutil --external:utf-8-validate",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "check-db": "esbuild scripts/checkDatabase.js --bundle --platform=node --target=node20 --format=cjs --outfile=dist/checkDatabase.js --alias:@=../src --external:pg-native --external:bufferutil --external:utf-8-validate && node dist/checkDatabase.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9"
  }
}
